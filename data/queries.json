[{"id":"q_mv2xujyza0j1k","name":"Relatório de Vendas do Mês","categories":["Pedidos"],"description":"","source_filename":"vendas_mes.json","columns":[{"name":"id_pedido","label":"ID do Pedido","type":"text"},{"name":"data_emissao","label":"Data de Emissão","type":"date"},{"name":"nome_cliente","label":"Cliente","type":"text"},{"name":"valor_total","label":"Valor Total (R$)","type":"text"},{"name":"status","label":"Status do Pedido","type":"text"}],"primary_columns":["id_pedido","data_emissao","nome_cliente"],"required_filters":[{"name":":data_inicio","label":"Data Inicial","type":"date"},{"name":":data_fim","label":"Data Final","type":"date"}],"created_at":1791669647772,"raw_json":{"name":"Relatório de Vendas do Mês","query":"SELECT p.id AS id_pedido, p.data_emissao, c.nome AS nome_cliente, p.valor_total, p.status FROM pedido p JOIN cliente c ON c.id = p.cliente_id WHERE p.data_emissao >= :data_inicio AND p.data_emissao <= :data_fim ORDER BY p.data_emissao DESC","field":[{"name":"id_pedido","title":"ID do Pedido","tipo":1,"typeField":"text","order":1},{"name":"data_emissao","title":"Data de Emissão","tipo":1,"typeField":"date","order":2},{"name":"nome_cliente","title":"Cliente","tipo":1,"typeField":"text","order":3},{"name":"valor_total","title":"Valor Total (R$)","tipo":1,"typeField":"text","order":4},{"name":"status","title":"Status do Pedido","tipo":1,"typeField":"text","order":5},{"name":":data_inicio","title":"Data Inicial","tipo":2,"typeField":"date","order":1},{"name":":data_fim","title":"Data Final","tipo":2,"typeField":"date","order":2}]}},{"id":"q_mv2xujz0zz02m","name":"Produtos com Estoque Mínimo","categories":["Produtos","Estoque"],"description":"","source_filename":"estoque.json","columns":[{"name":"codigo_sku","label":"SKU","type":"text"},{"name":"nome_produto","label":"Descrição do Produto","type":"text"},{"name":"quantidade_atual","label":"Qtd. Atual","type":"text"},{"name":"quantidade_minima","label":"Qtd. Mínima","type":"text"}],"primary_columns":["codigo_sku","nome_produto","quantidade_atual"],"required_filters":[{"name":":estoque_limite","label":"Estoque Limite","type":"text"}],"created_at":1791669647772,"raw_json":{"name":"Produtos com Estoque Mínimo","query":"SELECT p.codigo_sku, p.nome AS nome_produto, e.quantidade_atual, e.quantidade_minima FROM produto p JOIN estoque e ON e.produto_id = p.id WHERE e.quantidade_atual <= :estoque_limite ORDER BY e.quantidade_atual ASC","field":[{"name":"codigo_sku","title":"SKU","tipo":1,"typeField":"text","order":1},{"name":"nome_produto","title":"Descrição do Produto","tipo":1,"typeField":"text","order":2},{"name":"quantidade_atual","title":"Qtd. Atual","tipo":1,"typeField":"text","order":3},{"name":"quantidade_minima","title":"Qtd. Mínima","tipo":1,"typeField":"text","order":4},{"name":":estoque_limite","title":"Estoque Limite","tipo":2,"typeField":"text","order":1}]}}]
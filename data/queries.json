[{"id":"q_mv5lij7ukuoza","num":1,"name":"<img src=x onerror=alert(1)> Clientes (teste de escape de HTML)","categories":["Clientes"],"description":"","source_filename":"133_sku_e_estoque_sem_estoque (3).json","columns":[{"name":"pr_sku","label":"SKU","type":"text"},{"name":"e_sku","label":"SKU","type":"text"},{"name":"e_qtd_minima","label":"Estoque mínimo","type":"number"},{"name":"e_qtd_disponivel","label":"Quantidade disponível","type":"number"},{"name":"pr_ativo","label":"Ativo","type":"text"},{"name":"pr_dt_cadastro","label":"Data de cadastro do produto","type":"date"},{"name":"pr_ncm","label":"NCM","type":"text"},{"name":"m_pais_origem","label":"País de origem","type":"text"},{"name":"e_deposito_id","label":"Código do depósito","type":"number"},{"name":"e_custo_medio","label":"Custo médio","type":"money"},{"name":"pr_preco","label":"Preço de venda","type":"money"},{"name":"m_nome","label":"Nome da marca","type":"text"},{"name":"pr_peso_kg","label":"Peso (kg)","type":"number"}],"primary_columns":["pr_sku","e_sku","e_qtd_minima"],"required_filters":[{"name":":data_inicio","label":"Data inicial","type":"date"},{"name":":data_fim","label":"Data final","type":"date"}],"created_at":1791830330059,"updated_at":1791830335043,"raw_json":{"name":"<img src=x onerror=alert(1)> Clientes (teste de escape de HTML)","query":"-- Consulta de teste 133 | SKU e estoque sem estoque\n-- Dados fictícios, gerada para teste de carga\n/* valores monetários em reais */\nSELECT\n  UPPER(TRIM(pr.sku)) AS pr_sku,\n  UPPER(TRIM(e.sku)) AS e_sku,\n  e.qtd_minima AS e_qtd_minima,\n  COALESCE(e.qtd_disponivel, 0) AS e_qtd_disponivel,\n  pr.ativo AS pr_ativo,\n  pr.dt_cadastro AS pr_dt_cadastro,\n  pr.ncm AS pr_ncm,\n  m.pais_origem AS m_pais_origem,\n  e.deposito_id AS e_deposito_id,\n  ROUND(COALESCE(e.custo_medio, 0)::numeric, 2) AS e_custo_medio,\n  ROUND(COALESCE(pr.preco, 0)::numeric, 2) AS pr_preco,\n  m.nome AS m_nome,\n  pr.peso_kg AS pr_peso_kg\nFROM produtos pr\n  LEFT JOIN estoque e ON e.sku = pr.sku\n  LEFT JOIN marcas m ON m.marca_id = pr.marca_id\n  LEFT JOIN estoque ax ON ax.sku = pr.sku\nWHERE pr.dt_cadastro BETWEEN :data_inicio AND :data_fim\n  AND ax.est_id IS NULL\nORDER BY pr.dt_cadastro DESC","field":[{"name":"pr_sku","title":"SKU","tipo":1,"typeField":"text"},{"name":"e_sku","title":"SKU","tipo":1,"typeField":"text"},{"name":"e_qtd_minima","title":"Estoque mínimo","tipo":1,"typeField":"number"},{"name":"e_qtd_disponivel","title":"Quantidade disponível","tipo":1,"typeField":"number"},{"name":"pr_ativo","title":"Ativo","tipo":1,"typeField":"text"},{"name":"pr_dt_cadastro","title":"Data de cadastro do produto","tipo":1,"typeField":"date"},{"name":"pr_ncm","title":"NCM","tipo":1,"typeField":"text"},{"name":"m_pais_origem","title":"País de origem","tipo":1,"typeField":"text"},{"name":"e_deposito_id","title":"Código do depósito","tipo":1,"typeField":"number"},{"name":"e_custo_medio","title":"Custo médio","tipo":1,"typeField":"money"},{"name":"pr_preco","title":"Preço de venda","tipo":1,"typeField":"money"},{"name":"m_nome","title":"Nome da marca","tipo":1,"typeField":"text"},{"name":"pr_peso_kg","title":"Peso (kg)","tipo":1,"typeField":"number"},{"name":":data_inicio","title":"Data inicial","tipo":2,"typeField":"date"},{"name":":data_fim","title":"Data final","tipo":2,"typeField":"date"}]}}]
[{"id":"q_mv43ijqfwblif","num":1,"name":"Produtos com Estoque Mínimo","categories":["Produtos","Estoque"],"description":"","source_filename":"estoque (1).json","columns":[{"name":"codigo_sku","label":"SKU","type":"text"},{"name":"nome_produto","label":"Descrição do Produto","type":"text"},{"name":"quantidade_atual","label":"Qtd. Atual","type":"text"},{"name":"quantidade_minima","label":"Qtd. Mínima","type":"text"}],"primary_columns":["codigo_sku","nome_produto","quantidade_atual"],"required_filters":[{"name":":estoque_limite","label":"Estoque Limite","type":"text"}],"created_at":1791739631463,"updated_at":1791739634303,"raw_json":{"name":"Produtos com Estoque Mínimo","query":"SELECT p.codigo_sku, p.nome AS nome_produto, e.quantidade_atual, e.quantidade_minima FROM produto p JOIN estoque e ON e.produto_id = p.id WHERE e.quantidade_atual <= :estoque_limite ORDER BY e.quantidade_atual ASC","field":[{"name":"codigo_sku","title":"SKU","tipo":1,"typeField":"text","order":1},{"name":"nome_produto","title":"Descrição do Produto","tipo":1,"typeField":"text","order":2},{"name":"quantidade_atual","title":"Qtd. Atual","tipo":1,"typeField":"text","order":3},{"name":"quantidade_minima","title":"Qtd. Mínima","tipo":1,"typeField":"text","order":4},{"name":":estoque_limite","title":"Estoque Limite","tipo":2,"typeField":"text","order":1}]}}]
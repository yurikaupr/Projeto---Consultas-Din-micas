[{"id":"q_mv4fr1dv1l4ln","num":1,"name":"Listagem de Clientes Ativos por Estado","categories":["Clientes"],"description":"","source_filename":"clientes (2).json","columns":[{"name":"id_cliente","label":"ID Cliente","type":"text"},{"name":"nome","label":"Nome Razão Social","type":"text"},{"name":"cpf_cnpj","label":"CPF / CNPJ","type":"text"},{"name":"email","label":"E-mail de Contato","type":"text"},{"name":"uf","label":"Estado (UF)","type":"text"}],"primary_columns":["id_cliente","nome","cpf_cnpj","email"],"required_filters":[{"name":":estado_uf","label":"UF (ex: SC, SP, PR)","type":"text"}],"created_at":1791760182979,"updated_at":1791760199712,"raw_json":{"name":"Listagem de Clientes Ativos por Estado","query":"SELECT c.id AS id_cliente, c.nome, c.cpf_cnpj, c.email, e.uf FROM cliente c JOIN endereco e ON e.cliente_id = c.id WHERE e.uf = :estado_uf AND c.ativo = true ORDER BY c.nome ASC","field":[{"name":"id_cliente","title":"ID Cliente","tipo":1,"typeField":"text","order":1},{"name":"nome","title":"Nome Razão Social","tipo":1,"typeField":"text","order":2},{"name":"cpf_cnpj","title":"CPF / CNPJ","tipo":1,"typeField":"text","order":3},{"name":"email","title":"E-mail de Contato","tipo":1,"typeField":"text","order":4},{"name":"uf","title":"Estado (UF)","tipo":1,"typeField":"text","order":5},{"name":":estado_uf","title":"UF (ex: SC, SP, PR)","tipo":2,"typeField":"text","order":1}]}}]